<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FitLife" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Primary colors -->
        <item name="android:colorPrimary">@color/fitlife_blue_40</item>
        <item name="android:colorPrimaryDark">@color/fitlife_blue_30</item>
        <item name="android:colorAccent">@color/fitlife_green_40</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/fitlife_white</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/fitlife_blue_40</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>